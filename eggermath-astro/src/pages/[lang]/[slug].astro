---
import EmulatorLayout from '../../layouts/EmulatorLayout.astro';
import NoscriptFallback from '../../components/NoscriptFallback.astro';
import EmulatorContainer from '../../components/EmulatorContainer.astro';
import TouchControls from '../../components/TouchControls.astro';
import { games, SITE } from '../../data/games.js';
import { gameTranslations, supportedLangs, langNames } from '../../data/translations.js';
import { regionalKeywords } from '../../data/keywords.js';

export function getStaticPaths() {
  const paths = [];
  for (const lang of ["pt-BR","es","ja","de","fr","ru","ko","it","id","ar"]) {
    for (const game of games) {
      paths.push({ params: { lang, slug: game.slug }, props: { game, lang } });
    }
  }
  return paths;
}

const { game, lang } = Astro.props;
const tr = gameTranslations[game.slug]?.[lang] || gameTranslations[game.slug]?.['en'] || {};
const pageTitle = tr.title || `Play ${game.title} Online Free`;
const pageDesc = tr.desc || game.desc;
const langName = langNames[lang] || lang;
const relatedGames = games.filter(g => g.genre === game.genre && g.slug !== game.slug).slice(0, 4);

// Pick 3 most relevant regional keywords for this game+lang (no stuffing: used in desc + schema only)
function pickKeywords(game, lang) {
  const pool = regionalKeywords[lang] || regionalKeywords['en'] || [];
  if (!pool.length) return [];
  const series = (game.series || '').toLowerCase();
  const system = (game.system || 'gba').toLowerCase();
  const firstWord = game.title.split(/[\s:]+/)[0].toLowerCase();
  const scored = pool.map(kw => {
    const k = kw.toLowerCase();
    let s = 0;
    if (series && k.includes(series)) s += 10;
    if (firstWord.length > 2 && k.includes(firstWord)) s += 8;
    if (k.includes(system)) s += 6;
    if (k.includes('emulador') || k.includes('emulator') || k.includes('emulateur') || k.includes('emulatore') || k.includes('エミュ') || k.includes('에뮬') || k.includes('эмулятор')) s += 4;
    // Prefer short generic keywords over long specific ones (avoid cross-game contamination)
    const wc = k.split(' ').length;
    if (wc <= 2) s += 5;
    else if (wc <= 3) s += 3;
    if (wc >= 5) s -= 3;
    // Penalize off-topic modifiers
    if (k.includes('cheats') || k.includes('cheat') || k.includes('trucchi') || k.includes('code triche')) s -= 8;
    if (k.includes('hack rom') || k.includes('my boy') || k.includes('download')) s -= 4;
    // Penalize if keyword contains another game variant not matching current title (e.g. fire red for emerald)
    const variants = ['fire red','firered','leaf green','leafgreen','ruby','sapphire','emerald','crystal','gold','silver','yellow','minish','super mario world','mario kart','metroid','castlevania','zelda'];
    const titleLow = game.title.toLowerCase();
    for (const v of variants) {
      if (k.includes(v) && !titleLow.includes(v)) s -= 12;
    }
    return { kw, s };
  });
  scored.sort((a,b) => b.s - a.s);
  const seen = new Set();
  const out = [];
  for (const {kw} of scored) {
    const low = kw.toLowerCase();
    if (!seen.has(low)) { seen.add(low); out.push(kw); }
    if (out.length >= 3) break;
  }
  return out;
}
const topKeywords = pickKeywords(game, lang);
// Enhanced description: keep translated desc but expand to ~140-155 chars with 1-2 keywords naturally (Bing flagged short descs)
let enhancedDesc = pageDesc;
if (topKeywords.length >= 1) {
  const suffix2 = ` — ${topKeywords[0]}, ${topKeywords[1] || ''}`.replace(/, $/, '');
  const suffix1 = ` — ${topKeywords[0]}`;
  if (topKeywords.length >= 2 && (enhancedDesc + suffix2).length <= 155) enhancedDesc = enhancedDesc + suffix2;
  else if ((enhancedDesc + suffix1).length <= 155) enhancedDesc = enhancedDesc + suffix1;
}

const alternateLinks = supportedLangs.map(l => {
  const href = l === 'en' ? `${SITE.url}/${game.slug}/` : `${SITE.url}/${l}/${game.slug}/`;
  return `<link rel="alternate" hreflang="${l}" href="${href}" />`;
}).join('\n  ');
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoGame",
      "name": pageTitle,
      "description": enhancedDesc,
      "url": `${SITE.url}/${lang}/${game.slug}/`,
      "image": game.img,
      "gamePlatform": game.system || "Game Boy Advance",
      "genre": game.genre,
      "keywords": topKeywords.join(', '),
      "datePublished": String(game.year),
      "applicationCategory": "GameEmulator",
      "isAccessibleForFree": true,
      "inLanguage": lang,
      "author": { "@type": "Organization", "name": SITE.name },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": game.title, "item": `${SITE.url}/${game.slug}/` }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": `How to play ${game.title} on iPhone?`, "acceptedAnswer": { "@type": "Answer", "text": `Open ${SITE.url}/${game.slug}/ on Safari, tap to start. Use touch controls (D-pad, A/B, L/R). Save with Save button — works offline after first load.` } },
        { "@type": "Question", "name": `Is ${game.title} free to play?`, "acceptedAnswer": { "@type": "Answer", "text": `Yes, ${game.title} is free on EggerMath via browser mGBA emulator. No download, no signup.` } },
        { "@type": "Question", "name": `Can I save ${game.title} progress?`, "acceptedAnswer": { "@type": "Answer", "text": `Yes — click Save (F5) and Load (F9). 10 slots (Slot button / F7). Saved in browser storage.` } },
        { "@type": "Question", "name": `What are ${game.title} controls?`, "acceptedAnswer": { "@type": "Answer", "text": `D-Pad: WASD/Arrows, A: K, B: J, L: Q (GBA only), R: E (GBA only), Start: Enter, Select: Right Shift. On mobile use touch controls.` } }
      ]
    },
    {
      "@type": "HowTo",
      "name": `How to Play ${game.title} Online`,
      "totalTime": "PT1M",
      "step": [
        { "@type": "HowToStep", "name": "Open Game", "text": `Go to ${SITE.url}/${game.slug}/`, "url": `${SITE.url}/${game.slug}/` },
        { "@type": "HowToStep", "name": "Start", "text": "Wait for loading, tap screen to enter fullscreen if prompted." },
        { "@type": "HowToStep", "name": "Play", "text": "Use keyboard or touch controls to play." },
        { "@type": "HowToStep", "name": "Save", "text": "Press Save (F5) to save, Load (F9) to continue later." }
      ]
    }
  ]
};
---

<EmulatorLayout
  title={`${pageTitle} | EggerMath`}
  description={enhancedDesc}
  canonical={`${SITE.url}/${lang}/${game.slug}/`}
  jsonLd={jsonLd}
  hreflangHtml={alternateLinks}
>
  <NoscriptFallback />

  <nav class="game-topbar">
    <a href="/" class="back-link">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      All Games
    </a>
    <span class="game-topbar-title">{game.title}</span>
    <span class="game-topbar-meta">{game.genre} &middot; {game.year}</span>
  </nav>

  <div id="file-info">
    <div class="name" id="file-name"></div>
  </div>
  <div class="progress-bar" id="progress-bar">
    <div class="progress-fill" id="progress-fill"></div>
  </div>
  <div class="status-text" id="status-text"></div>

  <main class="game-embed">
    <div class="emulator-container" id="emulator-container">
      <canvas id="emulator-canvas"></canvas>
    </div>

    <div class="game-canvas-wrap" id="game-canvas-wrap">
      <div id="game-loading">
        <div class="loading-spinner"></div>
        <p>Loading {game.title}...</p>
      </div>
    </div>

    <div class="game-controls-bar">
      <div class="controls-left">
        <button id="btn-save-state" class="ctrl-btn" title="Save State (F5)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          <span>Save</span>
        </button>
        <button id="btn-load-state" class="ctrl-btn" title="Load State (F9)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          <span>Load</span>
        </button>
        <button id="btn-slot" class="ctrl-btn" title="Switch Slot (F7)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
          <span>Slot <i id="slot-num">0</i></span>
        </button>
      </div>
      <div class="controls-center">
        <button id="btn-fast-forward" class="ctrl-btn" title="Fast Forward">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" y1="5" x2="19" y2="19"/></svg>
          <span>FF</span>
        </button>
        <button id="btn-mute" class="ctrl-btn" title="Mute">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
          <span>Mute</span>
        </button>
        <button id="btn-reset" class="ctrl-btn" title="Reset">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          <span>Reset</span>
        </button>
      </div>
      <div class="controls-right">
        <button id="btn-fullscreen" class="ctrl-btn" title="Fullscreen">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
          <span>Fullscreen</span>
        </button>
      </div>
    </div>

    <div class="keyboard-hints desktop-only">
      <div class="kbd-hint"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or <kbd>&uarr;</kbd><kbd>&larr;</kbd><kbd>&darr;</kbd><kbd>&rarr;</kbd> D-Pad</div>
      <div class="kbd-hint"><kbd>K</kbd> A &nbsp; <kbd>J</kbd> B &nbsp; <kbd>Q</kbd> L &nbsp; <kbd>E</kbd> R</div>
      <div class="kbd-hint"><kbd>Enter</kbd> Start &nbsp; <kbd>RShift</kbd> Select</div>
      <div class="kbd-hint"><kbd>F5</kbd> Save &nbsp; <kbd>F7</kbd> Slot &nbsp; <kbd>F9</kbd> Load &nbsp; Double-click canvas for fullscreen</div>
    </div>

    <TouchControls />
  </main>

  <section class="embed-widget"><h3>Embed this game</h3><p>Copy code to embed on your site (backlink to eggermath.com):</p><pre>{`<iframe src="https://www.eggermath.com/${game.slug}/" width="480" height="320"></iframe>`}</pre><button onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent)">Copy</button></section>
  <section class="share-widget"><a href={`https://twitter.com/intent/tweet?text=Play ${game.title} online&url=${SITE.url}/${game.slug}/`} target="_blank">Share on X</a> <a href={`https://www.reddit.com/submit?url=${SITE.url}/${game.slug}/&title=Play ${game.title}`} target="_blank">Share on Reddit</a></section>

  <section class="game-info">
    <h2>About {game.title}</h2>
    <p>{game.desc}</p>
    <div class="game-meta">
      <span>Genre: {game.genre}</span> · <span>{game.year}</span> · <span>{game.developer}</span>
    </div>
    <div class="geo-answer">
      <h2>Play {game.title} Online — Free {game.system} Emulator</h2>
      <p><strong>Play {game.title} Online</strong> is a free browser-based {game.system} emulator experience on EggerMath. No download, no signup — click Play and the game loads via mGBA WebAssembly at 240×160, pixel-perfect. Use WASD or Arrow Keys for D-Pad, K for A, J for B, Q/L and E/R for shoulders (GBA), Enter for Start, Right Shift for Select. Save instantly with F5 (10 slots, F7 to switch) and load with F9; progress is cached in IndexedDB so you can resume offline after the first load. {game.title} is a {game.genre} title from {game.year} by {game.developer}, part of the {game.series} series, playable here with touch controls on iOS/Android and save states that persist in your browser.</p>
    </div>
    <div class="eeat-byline">
      <span>Reviewed by <strong>EggerMath Team</strong> · mGBA WASM verified · <a href="/pages/about">About</a> · Updated {new Date().getFullYear()}</span>
    </div>
  </section>

  {relatedGames.length > 0 && (
    <section class="related-games">
      <h3>Similar {game.genre} Games</h3>
      <div class="related-grid">
        {relatedGames.map(g => (
          <a href={`/${g.slug}/`} class="related-card">
            <img src={g.img} alt={`Play ${g.title} online`} loading="lazy" width="120" height="80" />
            <span>{g.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="game-faq">
    <h3>FAQ — {game.title}</h3>
    <details><summary>How to play {game.title} on iPhone?</summary><p>Open this page on Safari, tap to start. Touch controls appear automatically. Save via Save button — works offline after first load.</p></details>
    <details><summary>Is {game.title} free?</summary><p>Yes, free on EggerMath via browser mGBA emulator. No download, no signup.</p></details>
    <details><summary>Can I save progress?</summary><p>Click Save (F5) and Load (F9). 10 slots via Slot button / F7. Stored in browser.</p></details>
    <details><summary>What are the controls?</summary><p>D-Pad: WASD/Arrows, A: K, B: J, L: Q, R: E, Start: Enter, Select: Right Shift. Mobile: touch controls.</p></details>
  </section>

  </EmulatorLayout>

<style>
  .game-topbar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 20px;
    background: rgba(0,0,0,0.3);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    position: sticky;
    top: 0;
    z-index: 90;
  }
  .back-link {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .back-link:hover { color: var(--accent-light); }
  .game-topbar-title {
    font-weight: 600;
    font-size: 15px;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .game-topbar-meta {
    margin-left: auto;
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  #file-info, .progress-bar, .status-text { display: none; }
  #file-info.visible { display: block; }
  .progress-bar.visible { display: block; }

  .game-embed {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: calc(100vh - 50px);
    padding: 16px;
    gap: 12px;
  }
  .game-canvas-wrap {
    position: relative;
    width: 100%;
    max-width: 800px;
    aspect-ratio: 3/2;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid rgba(255,255,255,0.08);
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }
  #game-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-muted);
    font-size: 14px;
  }
  #game-loading.hidden { display: none; }

  .emulator-container {
    display: none;
    width: 100%;
    max-width: 800px;
  }
  .emulator-container.visible {
    display: block;
  }
  .emulator-container.visible ~ .game-controls-bar {
    display: flex;
  }
  .emulator-container:not(.visible) ~ .game-controls-bar {
    display: none;
  }
  .emulator-container.visible ~ .game-canvas-wrap {
    display: none;
  }
  #emulator-canvas {
    display: block;
    width: 100%;
    margin: 0 auto;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    object-fit: contain;
    background: #000;
    border-radius: 12px;
    border: 2px solid rgba(255,255,255,0.08);
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }
  .loading-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(255,255,255,0.1);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .game-controls-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 800px;
    padding: 8px 12px;
    background: rgba(255,255,255,0.04);
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.06);
  }
  .controls-left, .controls-center, .controls-right {
    display: flex;
    gap: 4px;
  }
  .ctrl-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 10px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    color: var(--text);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .ctrl-btn.active {
    background: var(--accent-amber) !important;
    border-color: var(--accent-amber) !important;
    color: #000 !important;
  }
  .ctrl-btn:hover {
    background: rgba(255,255,255,0.12);
    border-color: var(--accent);
    color: var(--accent);
  }
  .ctrl-btn svg { flex-shrink: 0; }

  .keyboard-hints {
    width: 100%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 16px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
  }
  .kbd-hint {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.6;
  }
  kbd {
    display: inline-block;
    padding: 1px 6px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 4px;
    font-family: inherit;
    font-size: 11px;
    color: var(--accent);
    line-height: 1.4;
  }

  .desktop-only { display: block; }

  .emulator-container:fullscreen {
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .emulator-container:fullscreen #emulator-canvas {
    width: auto;
    height: 100vh;
    max-width: 100vw;
    border-radius: 0;
    border: none;
    box-shadow: none;
    object-fit: contain;
  }

  @media (max-width: 600px) {
    .game-topbar { padding: 8px 12px; gap: 8px; }
    .game-topbar-meta { display: none; }
    .game-embed { padding: 4px; gap: 6px; min-height: auto; }
    .game-canvas-wrap { border-radius: 8px; border-width: 1px; }
    .game-controls-bar { padding: 4px 6px; gap: 2px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .ctrl-btn { padding: 4px 6px; font-size: 10px; white-space: nowrap; flex-shrink: 0; }
    .ctrl-btn svg { width: 14px; height: 14px; }
    .emulator-container { max-width: 100%; border-radius: 8px; border-width: 1px; }
    #emulator-canvas { border-radius: 8px; border-width: 1px; }
    .keyboard-hints { display: none !important; }
  }
  .game-info, .related-games, .game-faq {
    max-width: 800px;
    margin: 24px auto 0;
    padding: 16px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
  }
  .game-info h2, .related-games h3, .game-faq h3 { font-size: 1.1rem; margin-bottom: 8px; color: var(--text); }
  .game-info p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }
  .game-meta { font-size: 0.8rem; color: var(--text-muted); margin-top: 8px; }
  .related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .related-card { display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--text); font-size: 0.85rem; }
  .related-card img { width: 100%; border-radius: 8px; aspect-ratio: 3/2; object-fit: cover; }
  .game-faq details { padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .game-faq summary { cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--text); }
  .game-faq p { font-size: 0.85rem; color: var(--text-muted); margin-top: 6px; }
  @media (max-width: 600px) { .related-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (pointer: coarse) {
    .desktop-only { display: none !important; }
  }
  @media (hover: none) and (pointer: coarse) {
    .desktop-only { display: none !important; }
  }
  .embed-widget, .share-widget {
    max-width: 800px;
    margin: 24px auto 0;
    padding: 16px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
  }
  .embed-widget h3 { font-size: 1.1rem; margin-bottom: 8px; color: var(--text); }
  .embed-widget p { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px; }
  .embed-widget pre {
    padding: 12px;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    font-family: monospace;
    font-size: 12px;
    color: var(--text);
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .embed-widget button {
    margin-top: 8px;
    padding: 6px 12px;
    background: var(--accent);
    color: #fff;
    border: none;
