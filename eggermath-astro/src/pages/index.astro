---
import EmulatorLayout from '../layouts/EmulatorLayout.astro';
import NoscriptFallback from '../components/NoscriptFallback.astro';
import UploadArea from '../components/UploadArea.astro';
import ContinueBar from '../components/ContinueBar.astro';
import EmulatorContainer from '../components/EmulatorContainer.astro';
import TouchControls from '../components/TouchControls.astro';
import ControlsHelp from '../components/ControlsHelp.astro';
import GuideSteps from '../components/GuideSteps.astro';
import GameCard from '../components/GameCard.astro';
import { games, SITE } from '../data/games.js';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "EggerMath",
      "url": SITE.url,
      "logo": `${SITE.url}/favicon.svg`,
      "description": "Free browser-based GBA, GBC, and GB emulator. Play classic Game Boy games instantly online.",
      "sameAs": [
        "https://twitter.com/eggermath",
        "https://www.reddit.com/user/eggermath"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": SITE.email,
        "contactType": "customer service"
      }
    },
    {
      "@type": "WebSite",
      "name": SITE.name,
      "url": SITE.url,
      "description": "Free browser-based GBA, GBC, and GB emulator. Play classic Game Boy games instantly online.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${SITE.url}/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "CollectionPage",
      "name": "GBA Emulator Online - Play 52 Classic Games Free in Browser",
      "description": "Play 52 classic GBA, GBC, and GB games free in your browser. No download needed. Pokemon, Zelda, Mario & more.",
      "url": SITE.url,
      "isPartOf": { "@type": "WebSite", "name": SITE.name, "url": SITE.url },
      "mainEntity": {
        "@type": "VideoGameEmulator",
        "name": "EggerMath GBA/GBC/GB Emulator",
        "applicationCategory": "GameEmulator",
        "operatingSystem": "Any (Web Browser)",
        "numberOfGames": 52,
        "gamePlatform": "Game Boy Advance, Game Boy Color, Game Boy",
        "description": "Free browser-based GBA/GBC/GB emulator powered by mGBA WebAssembly"
      },
      "hasPart": {
        "@type": "ItemList",
        "itemListElement": games.slice(0, 15).map((g, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "item": {
            "@type": "VideoGame",
            "name": g.title,
            "description": g.desc,
            "gamePlatform": g.system || "Game Boy Advance",
            "genre": g.genre,
            "datePublished": String(g.year),
            "isAccessibleForFree": true
          }
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How do I play GBA games here?", "acceptedAnswer": { "@type": "Answer", "text": "Click any game in the library to play instantly, or drag-and-drop your own .gba, .zip, .gb, or .gbc ROM file into the upload area." } },
        { "@type": "Question", "name": "What keyboard controls do I use?", "acceptedAnswer": { "@type": "Answer", "text": "D-Pad: WASD or Arrow Keys. A: K. B: J. L: Q. R: E. Start: Enter. Select: Right Shift. Save: F5. Load: F9. Slot: F7." } },
        { "@type": "Question", "name": "Does it work on mobile?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Touch controls appear automatically on phones and tablets. Works in Chrome, Safari, and Firefox on iOS and Android." } },
        { "@type": "Question", "name": "Can I save my progress?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Use F5 to save and F9 to load. You have 10 save slots (F7 to switch). Progress is stored in your browser." } },
        { "@type": "Question", "name": "What ROM formats are supported?", "acceptedAnswer": { "@type": "Answer", "text": "Supports .gba, .zip, .gb, and .gbc files. You can drag and drop ROMs or use the file picker." } }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Play GBA Games Online",
      "description": "Step-by-step guide to playing GBA games in your browser",
      "totalTime": "PT1M",
      "step": [
        { "@type": "HowToStep", "name": "Open the Emulator", "text": "Go to eggermath.com in your browser.", "url": SITE.url },
        { "@type": "HowToStep", "name": "Choose a Game", "text": "Click any game from the built-in library, or drag-and-drop your own .gba, .zip, .gb, or .gbc ROM file." },
        { "@type": "HowToStep", "name": "Play", "text": "Use keyboard controls (Arrow keys = D-Pad, K = A, J = B, Enter = Start) or touch controls on mobile." },
        { "@type": "HowToStep", "name": "Save Progress", "text": "Press F5 to save, F9 to load, F7 to switch between 10 save slots." }
      ]
    }
  ]
};
---

<EmulatorLayout jsonLd={jsonLd}>
  <NoscriptFallback />
  <main class="main">
    <UploadArea />
    <ContinueBar />
    <div class="pre-game-content" id="pre-game-content">
      <section class="browse-section">
        <div class="browse-header">
          <div class="hero-badge">
            <span class="hero-badge-dot"></span>
            52 carts seated · no install
          </div>
          <div class="browse-header-top">
            <div>
              <h1>GBA emulator<br><span style="color: var(--text-secondary);">online — play 52 games free.</span></h1>
              <p class="browse-sub">Play Pokemon, Zelda, Mario, Metroid and 48 more classic GBA games free in your browser. No download needed. Hover a cart — the handheld lights it up.</p>
            </div>
            <div class="catalog-search-wrap">
              <svg class="catalog-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
              </svg>
              <input type="text" class="catalog-search-input" id="game-search" placeholder="Find a title..." autocomplete="off">
            </div>
          </div>
          <div class="catalog-toolbar">
            <div class="catalog-filters" id="genre-filters">
              <button class="filter-chip active" data-genre="All">All</button>
              <button class="filter-chip" data-genre="RPG">RPG</button>
              <button class="filter-chip" data-genre="Adventure">Adventure</button>
              <button class="filter-chip" data-genre="Platformer">Platformer</button>
              <button class="filter-chip" data-genre="Action">Action</button>
              <button class="filter-chip" data-genre="Puzzle">Puzzle</button>
              <button class="filter-chip" data-genre="Racing">Racing</button>
              <button class="filter-chip" data-genre="Fighting">Fighting</button>
              <button class="filter-chip" data-genre="Strategy">Strategy</button>
              <button class="filter-chip" data-genre="Simulation">Simulation</button>
            </div>
            <div class="catalog-filters" id="system-filters">
              <button class="filter-chip shell active" data-system="All">All systems</button>
              <button class="filter-chip shell" data-system="GBA">GBA</button>
              <button class="filter-chip shell" data-system="GBC">GBC</button>
              <button class="filter-chip shell" data-system="GB">GB</button>
            </div>
          </div>
          <div class="hero-stats">
            <div>
              <div class="hero-stat-num">52</div>
              <div class="hero-stat-label">built-in games</div>
            </div>
            <div>
              <div class="hero-stat-num">0</div>
              <div class="hero-stat-label">downloads</div>
            </div>
            <div>
              <div class="hero-stat-num">10</div>
              <div class="hero-stat-label">save slots</div>
            </div>
          </div>
        </div>
        <div class="games-grid" id="games-grid">
          {games.map(game => (
            <GameCard
              title={game.title}
              genre={game.genre}
              slug={game.slug}
              img={game.img}
              mega={game.mega}
              system={game.system}
            />
          ))}
        </div>
      </section>
      <GuideSteps />

      <section class="content-section">
        <h2>What is a GBA Emulator?</h2>
        <p>A GBA emulator lets you play Game Boy Advance games directly in your web browser without downloading any software. Our emulator uses mGBA WebAssembly, the same engine used by professional emulation projects. It supports GBA, GBC, and GB games with save states, fast forward, and keyboard/touch controls.</p>
        <ol>
          <li>Click any game from the library, or drag-and-drop your own .gba ROM file</li>
          <li>The game loads instantly in your browser — no installation required</li>
          <li>Use keyboard controls: Arrow keys = D-Pad, K = A button, J = B button, Enter = Start</li>
          <li>Save your progress anytime with F5, load with F9, switch slots with F7</li>
        </ol>

        <div class="features-grid">
          <div class="feature-card">
            <h3>52 built-in games</h3>
            <p>Pokemon, Zelda, Mario, Metroid, and a full gray-brick shelf besides.</p>
          </div>
          <div class="feature-card">
            <h3>No download required</h3>
            <p>Play directly in Chrome, Safari, Firefox, or Edge.</p>
          </div>
          <div class="feature-card">
            <h3>Save states</h3>
            <p>Ten slots. F5 saves, F9 loads, F7 cycles the active slot.</p>
          </div>
          <div class="feature-card">
            <h3>Fast forward</h3>
            <p>Hold the speed toggle when the grass is just grass.</p>
          </div>
          <div class="feature-card">
            <h3>Mobile support</h3>
            <p>Touch controls modeled on the original pad, shoulders, and face buttons.</p>
          </div>
          <div class="feature-card">
            <h3>Works everywhere</h3>
            <p>Progress lives in this browser. No account, no cloud.</p>
          </div>
        </div>

        <div class="controls-visual" style="margin-top: 40px;">
          <div class="controls-visual-header">
            <div>
              <p class="controls-visual-sub">Mapped like the plastic</p>
              <h2>Controls</h2>
            </div>
          </div>
          <div class="controls-key-grid">
            <div class="controls-key-row"><span>D-Pad</span><kbd>Arrow keys</kbd></div>
            <div class="controls-key-row"><span>A button</span><kbd>K</kbd></div>
            <div class="controls-key-row"><span>B button</span><kbd>J</kbd></div>
            <div class="controls-key-row"><span>Start</span><kbd>Enter</kbd></div>
            <div class="controls-key-row"><span>Select</span><kbd>Shift</kbd></div>
            <div class="controls-key-row"><span>L / R</span><kbd>Q / E</kbd></div>
            <div class="controls-key-row"><span>Save state</span><kbd>F5</kbd></div>
            <div class="controls-key-row"><span>Load state</span><kbd>F9</kbd></div>
            <div class="controls-key-row"><span>Next slot</span><kbd>F7</kbd></div>
            <div class="controls-key-row"><span>Fast forward</span><kbd>Space</kbd></div>
          </div>
          <p style="margin-top: 16px; font-size: 0.88rem; color: var(--text-secondary);">Touch controls activate on phones and tablets. Connect a keyboard or controller for the better commute.</p>
        </div>

        <h2 style="margin-top: 48px;">Frequently Asked</h2>
        <div class="faq-accordion" id="faq-accordion">
          <div class="faq-accordion-item open">
            <button class="faq-accordion-btn" aria-expanded="true">
              <span>Is it legal to play GBA games online?</span>
              <svg class="faq-accordion-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="faq-accordion-content">
              <p>Playing your own legally obtained ROM files is legal in most countries. EggerMath provides the emulator software only — you supply the ROM files.</p>
            </div>
          </div>
          <div class="faq-accordion-item">
            <button class="faq-accordion-btn" aria-expanded="false">
              <span>Does it work on iPhone?</span>
              <svg class="faq-accordion-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="faq-accordion-content">
              <p>Yes. The handheld works on iOS Safari with touch controls. No App Store download needed.</p>
            </div>
          </div>
          <div class="faq-accordion-item">
            <button class="faq-accordion-btn" aria-expanded="false">
              <span>Can I play Pokemon GBA games?</span>
              <svg class="faq-accordion-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="faq-accordion-content">
              <p>Yes. Pokemon Emerald, FireRed, LeafGreen, Ruby, Sapphire, and more sit in the binder. Click to play.</p>
            </div>
          </div>
          <div class="faq-accordion-item">
            <button class="faq-accordion-btn" aria-expanded="false">
              <span>How do I save my game?</span>
              <svg class="faq-accordion-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="faq-accordion-content">
              <p>Press F5 to save, F9 to load. You have 10 save slots — press F7 to switch between them. Saves are stored in your browser.</p>
            </div>
          </div>
          <div class="faq-accordion-item">
            <button class="faq-accordion-btn" aria-expanded="false">
              <span>What ROM formats are supported?</span>
              <svg class="faq-accordion-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="faq-accordion-content">
              <p>We support .gba, .zip, .gb, and .gbc files. You can drag and drop ROMs or use the file picker.</p>
            </div>
          </div>
        </div>
      </section>
    </div>
    <EmulatorContainer />
    <TouchControls />
    <ControlsHelp />

    <section class="content-section" style="margin-top:48px;">
      <h2>Latest Blog Posts</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.5rem;margin-top:1.5rem;">
        <a href="/blog/best-gba-games-2026" style="color:var(--accent-amber);text-decoration:none;padding:1.5rem;background:var(--bg-surface);border-radius:var(--radius-md);display:block;">
          <div style="font-size:0.8rem;color:var(--text-secondary);margin-bottom:0.5rem;">Aug 26, 2026</div>
          <h3 style="margin:0 0 0.5rem;font-size:1.1rem;">Best GBA Games to Play Online in 2026</h3>
          <p style="margin:0;color:var(--text-secondary);font-size:0.9rem;">Top 10 GBA games you can play free in your browser.</p>
        </a>
        <a href="/blog/how-to-save-gba-progress" style="color:var(--accent-amber);text-decoration:none;padding:1.5rem;background:var(--bg-surface);border-radius:var(--radius-md);display:block;">
          <div style="font-size:0.8rem;color:var(--text-secondary);margin-bottom:0.5rem;">Aug 25, 2026</div>
          <h3 style="margin:0 0 0.5rem;font-size:1.1rem;">How to Save Your GBA Game Progress in Browser</h3>
          <p style="margin:0;color:var(--text-secondary);font-size:0.9rem;">Step-by-step guide to using save states in browser-based GBA emulators.</p>
        </a>
        <a href="/blog/gba-vs-gbc-which-is-better" style="color:var(--accent-amber);text-decoration:none;padding:1.5rem;background:var(--bg-surface);border-radius:var(--radius-md);display:block;">
          <div style="font-size:0.8rem;color:var(--text-secondary);margin-bottom:0.5rem;">Aug 24, 2026</div>
          <h3 style="margin:0 0 0.5rem;font-size:1.1rem;">GBA vs GBC: Which Console Has Better Games?</h3>
          <p style="margin:0;color:var(--text-secondary);font-size:0.9rem;">Comparing Game Boy Advance and Game Boy Color libraries.</p>
        </a>
      </div>
    </section>
  </main>
</EmulatorLayout>

<script is:inline src="/ios-compat.js"></script>
<script is:inline type="module">
  import init from '/gba-emulator-web/mgba-v2.js';
  window.mGBA = init;
</script>
<script is:inline src="https://unpkg.com/megajs@1/dist/main.browser-umd.js"></script>
<script define:vars={{ gamesData: games }}>
  window.__GAMES_DATA__ = gamesData;
</script>
<script>
import '../scripts/emulator.js';
</script>

<script is:inline>
// Game filters, search, and FAQ accordion
(function() {
  // Game filtering
  const searchInput = document.getElementById('game-search');
  const genreFilters = document.getElementById('genre-filters');
  const systemFilters = document.getElementById('system-filters');
  const gamesGrid = document.getElementById('games-grid');
  
  if (searchInput && genreFilters && systemFilters && gamesGrid) {
    let currentGenre = 'All';
    let currentSystem = 'All';
    let searchQuery = '';
    
    function filterGames() {
      const cards = gamesGrid.querySelectorAll('.game-pill');
      let visibleCount = 0;
      
      cards.forEach(card => {
        const genre = card.dataset.genre || '';
        const system = card.dataset.system || '';
        const title = card.querySelector('.game-pill-title')?.textContent || '';
        
        const matchGenre = currentGenre === 'All' || genre === currentGenre;
        const matchSystem = currentSystem === 'All' || system === currentSystem;
        const matchSearch = !searchQuery || title.toLowerCase().includes(searchQuery);
        
        if (matchGenre && matchSystem && matchSearch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });
    }
    
    // Genre filter clicks
    genreFilters.addEventListener('click', (e) => {
      const btn = e.target.closest('.filter-chip');
      if (!btn) return;
      
      genreFilters.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentGenre = btn.dataset.genre;
      filterGames();
    });
    
    // System filter clicks
    systemFilters.addEventListener('click', (e) => {
      const btn = e.target.closest('.filter-chip');
      if (!btn) return;
      
      systemFilters.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentSystem = btn.dataset.system;
      filterGames();
    });
    
    // Search input
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      filterGames();
    });
  }
  
  // FAQ accordion
  const faqAccordion = document.getElementById('faq-accordion');
  if (faqAccordion) {
    faqAccordion.addEventListener('click', (e) => {
      const btn = e.target.closest('.faq-accordion-btn');
      if (!btn) return;
      
      const item = btn.closest('.faq-accordion-item');
      const isOpen = item.classList.contains('open');
      
      // Close all items
      faqAccordion.querySelectorAll('.faq-accordion-item').forEach(i => {
        i.classList.remove('open');
        i.querySelector('.faq-accordion-btn').setAttribute('aria-expanded', 'false');
      });
      
      // Toggle current item
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }
})();
</script>
