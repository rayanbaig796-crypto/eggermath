---
import EmulatorLayout from '../layouts/EmulatorLayout.astro';
import NoscriptFallback from '../components/NoscriptFallback.astro';
import UploadArea from '../components/UploadArea.astro';
import ContinueBar from '../components/ContinueBar.astro';
import EmulatorContainer from '../components/EmulatorContainer.astro';
import TouchControls from '../components/TouchControls.astro';
import ControlsHelp from '../components/ControlsHelp.astro';
import GuideSteps from '../components/GuideSteps.astro';
import GameCard from '../components/GameCard.astro';
import { games, SITE } from '../data/games.js';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "EggerMath",
      "url": SITE.url,
      "logo": `${SITE.url}/favicon.svg`,
      "description": "Free browser-based GBA, GBC, and GB emulator. Play classic Game Boy games instantly online.",
      "sameAs": [
        "https://twitter.com/eggermath",
        "https://www.reddit.com/user/eggermath"
      ]
    },
    {
      "@type": "CollectionPage",
      "name": "GBA Emulator Online — Play 52 Games Free",
      "description": "Play 52 classic GBA, GBC, and GB games free in your browser. No download needed. Pokemon, Zelda, Mario & more.",
      "url": SITE.url,
      "isPartOf": { "@type": "WebSite", "name": SITE.name, "url": SITE.url },
      "mainEntity": {
        "@type": "VideoGameEmulator",
        "name": "EggerMath GBA/GBC/GB Emulator",
        "applicationCategory": "GameEmulator",
        "operatingSystem": "Any (Web Browser)",
        "numberOfGames": 52,
        "gamePlatform": "Game Boy Advance, Game Boy Color, Game Boy",
        "description": "Free browser-based GBA/GBC/GB emulator powered by mGBA WebAssembly"
      },
      "hasPart": {
        "@type": "ItemList",
        "itemListElement": games.slice(0, 15).map((g, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "item": {
            "@type": "VideoGame",
            "name": g.title,
            "description": g.desc,
            "gamePlatform": g.system || "Game Boy Advance",
            "genre": g.genre,
            "datePublished": String(g.year),
            "isAccessibleForFree": true
          }
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How do I play GBA games here?", "acceptedAnswer": { "@type": "Answer", "text": "Click any game in the library to play instantly, or drag-and-drop your own .gba, .zip, .gb, or .gbc ROM file into the upload area." } },
        { "@type": "Question", "name": "What keyboard controls do I use?", "acceptedAnswer": { "@type": "Answer", "text": "D-Pad: WASD or Arrow Keys. A: K. B: J. L: Q. R: E. Start: Enter. Select: Right Shift. Save: F5. Load: F9. Slot: F7." } },
        { "@type": "Question", "name": "Does it work on mobile?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Touch controls appear automatically on phones and tablets. Works in Chrome, Safari, and Firefox on iOS and Android." } },
        { "@type": "Question", "name": "Can I save my progress?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Use F5 to save and F9 to load. You have 10 save slots (F7 to switch). Progress is stored in your browser." } },
        { "@type": "Question", "name": "What ROM formats are supported?", "acceptedAnswer": { "@type": "Answer", "text": "Supports .gba, .zip, .gb, and .gbc files. You can drag and drop ROMs or use the file picker." } }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Play GBA Games Online",
      "description": "Step-by-step guide to playing GBA games in your browser",
      "totalTime": "PT1M",
      "step": [
        { "@type": "HowToStep", "name": "Open the Emulator", "text": "Go to eggermath.com in your browser.", "url": SITE.url },
        { "@type": "HowToStep", "name": "Choose a Game", "text": "Click any game from the built-in library, or drag-and-drop your own .gba, .zip, .gb, or .gbc ROM file." },
        { "@type": "HowToStep", "name": "Play", "text": "Use keyboard controls (Arrow keys = D-Pad, K = A, J = B, Enter = Start) or touch controls on mobile." },
        { "@type": "HowToStep", "name": "Save Progress", "text": "Press F5 to save, F9 to load, F7 to switch between 10 save slots." }
      ]
    }
  ]
};
---

<EmulatorLayout jsonLd={jsonLd}>
  <NoscriptFallback />
  <main class="main">
    <UploadArea />
    <ContinueBar />
    <div class="pre-game-content" id="pre-game-content">
      <section class="browse-section">
        <div class="browse-header">
          <h1>GBA Emulator Online — Play 52 Games Free</h1>
          <span class="badge">Click to Play</span>
        </div>
        <p class="browse-sub">Play Pokemon, Zelda, Mario, Metroid and 48 more classic GBA games free in your browser. No download needed.</p>
        <div class="games-grid" id="games-grid">
          {games.map(game => (
            <GameCard
              title={game.title}
              genre={game.genre}
              slug={game.slug}
              img={game.img}
              mega={game.mega}
            />
          ))}
        </div>
      </section>
      <GuideSteps />

      <section class="content-section" style="max-width:900px;margin:48px auto;padding:0 24px;">
        <h2 style="color:#c4a35a;font-size:1.5rem;margin-bottom:16px;">What is a GBA Emulator?</h2>
        <p style="color:#aaa;line-height:1.8;margin-bottom:24px;">A GBA emulator lets you play Game Boy Advance games directly in your web browser without downloading any software. Our emulator uses mGBA WebAssembly, the same engine used by professional emulation projects. It supports GBA, GBC, and GB games with save states, fast forward, and keyboard/touch controls.</p>

        <h2 style="color:#c4a35a;font-size:1.5rem;margin-bottom:16px;">How to Play GBA Games Online</h2>
        <ol style="color:#aaa;line-height:1.8;margin-bottom:24px;padding-left:20px;">
          <li style="margin-bottom:8px;">Click any game from the library above, or drag-and-drop your own .gba ROM file</li>
          <li style="margin-bottom:8px;">The game loads instantly in your browser — no installation required</li>
          <li style="margin-bottom:8px;">Use keyboard controls: Arrow keys = D-Pad, K = A button, J = B button, Enter = Start</li>
          <li style="margin-bottom:8px;">Save your progress anytime with F5, load with F9, switch slots with F7</li>
        </ol>

        <h2 style="color:#c4a35a;font-size:1.5rem;margin-bottom:16px;">Why EggerMath?</h2>
        <ul style="color:#aaa;line-height:1.8;margin-bottom:24px;padding-left:20px;">
          <li style="margin-bottom:8px;"><strong style="color:#f0ebe0;">52 built-in games</strong> — Pokemon, Zelda, Mario, Metroid, and more</li>
          <li style="margin-bottom:8px;"><strong style="color:#f0ebe0;">No download required</strong> — play directly in your browser</li>
          <li style="margin-bottom:8px;"><strong style="color:#f0ebe0;">Save states</strong> — save and load your progress anytime</li>
          <li style="margin-bottom:8px;"><strong style="color:#f0ebe0;">Fast forward</strong> — speed up boring parts</li>
          <li style="margin-bottom:8px;"><strong style="color:#f0ebe0;">Mobile support</strong> — touch controls on phones and tablets</li>
          <li style="margin-bottom:8px;"><strong style="color:#f0ebe0;">Works everywhere</strong> — Chrome, Safari, Firefox, Edge</li>
        </ul>

        <h2 style="color:#c4a35a;font-size:1.5rem;margin-bottom:16px;">Frequently Asked Questions</h2>
        <div style="margin-bottom:16px;">
          <h3 style="color:#f0ebe0;font-size:1.1rem;margin-bottom:8px;">Is it legal to play GBA games online?</h3>
          <p style="color:#aaa;line-height:1.6;">Playing your own legally obtained ROM files is legal in most countries. EggerMath provides the emulator software only — you supply the ROM files.</p>
        </div>
        <div style="margin-bottom:16px;">
          <h3 style="color:#f0ebe0;font-size:1.1rem;margin-bottom:8px;">Does it work on iPhone?</h3>
          <p style="color:#aaa;line-height:1.6;">Yes. Our emulator works on iOS Safari with touch controls. No App Store download needed.</p>
        </div>
        <div style="margin-bottom:16px;">
          <h3 style="color:#f0ebe0;font-size:1.1rem;margin-bottom:8px;">Can I play Pokemon GBA games?</h3>
          <p style="color:#aaa;line-height:1.6;">Yes. We have Pokemon Emerald, FireRed, LeafGreen, Ruby, Sapphire, and more built-in. Just click to play.</p>
        </div>
        <div style="margin-bottom:16px;">
          <h3 style="color:#f0ebe0;font-size:1.1rem;margin-bottom:8px;">How do I save my game?</h3>
          <p style="color:#aaa;line-height:1.6;">Press F5 to save, F9 to load. You have 10 save slots — press F7 to switch between them. Your saves are stored in your browser.</p>
        </div>
      </section>
    </div>
    <EmulatorContainer />
    <TouchControls />
    <ControlsHelp />
  </main>
</EmulatorLayout>

<script is:inline src="/ios-compat.js"></script>
<script is:inline type="module">
  import init from '/gba-emulator-web/mgba-v2.js';
  window.mGBA = init;
</script>
<script is:inline src="https://unpkg.com/megajs@1/dist/main.browser-umd.js"></script>
<script define:vars={{ gamesData: games }}>
  window.__GAMES_DATA__ = gamesData;
</script>
<script>
import '../scripts/emulator.js';
</script>
