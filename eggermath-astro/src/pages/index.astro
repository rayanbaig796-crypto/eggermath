---
import EmulatorLayout from '../layouts/EmulatorLayout.astro';
import NoscriptFallback from '../components/NoscriptFallback.astro';
import UploadArea from '../components/UploadArea.astro';
import ContinueBar from '../components/ContinueBar.astro';
import EmulatorContainer from '../components/EmulatorContainer.astro';
import TouchControls from '../components/TouchControls.astro';
import ControlsHelp from '../components/ControlsHelp.astro';
import GuideSteps from '../components/GuideSteps.astro';
import GameCard from '../components/GameCard.astro';
import { games, SITE } from '../data/games.js';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "EggerMath",
      "url": SITE.url,
      "logo": `${SITE.url}/favicon.svg`,
      "description": "Free browser-based GBA, GBC, and GB emulator. Play classic Game Boy games instantly online.",
      "sameAs": [
        "https://twitter.com/eggermath",
        "https://www.reddit.com/user/eggermath"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": SITE.email,
        "contactType": "customer service"
      }
    },
    {
      "@type": "WebSite",
      "name": SITE.name,
      "url": SITE.url,
      "description": "Free browser-based GBA, GBC, and GB emulator. Play classic Game Boy games instantly online.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${SITE.url}/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "CollectionPage",
      "name": "GBA Emulator Online - Play 52 Classic Games Free in Browser",
      "description": "Play 52 classic GBA, GBC, and GB games free in your browser. No download needed. Pokemon, Zelda, Mario & more.",
      "url": SITE.url,
      "isPartOf": { "@type": "WebSite", "name": SITE.name, "url": SITE.url },
      "mainEntity": {
        "@type": "VideoGameEmulator",
        "name": "EggerMath GBA/GBC/GB Emulator",
        "applicationCategory": "GameEmulator",
        "operatingSystem": "Any (Web Browser)",
        "numberOfGames": 52,
        "gamePlatform": "Game Boy Advance, Game Boy Color, Game Boy",
        "description": "Free browser-based GBA/GBC/GB emulator powered by mGBA WebAssembly"
      },
      "hasPart": {
        "@type": "ItemList",
        "itemListElement": games.slice(0, 15).map((g, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "item": {
            "@type": "VideoGame",
            "name": g.title,
            "description": g.desc,
            "gamePlatform": g.system || "Game Boy Advance",
            "genre": g.genre,
            "datePublished": String(g.year),
            "isAccessibleForFree": true
          }
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How do I play GBA games here?", "acceptedAnswer": { "@type": "Answer", "text": "Click any game in the library to play instantly, or drag-and-drop your own .gba, .zip, .gb, or .gbc ROM file into the upload area." } },
        { "@type": "Question", "name": "What keyboard controls do I use?", "acceptedAnswer": { "@type": "Answer", "text": "D-Pad: WASD or Arrow Keys. A: K. B: J. L: Q. R: E. Start: Enter. Select: Right Shift. Save: F5. Load: F9. Slot: F7." } },
        { "@type": "Question", "name": "Does it work on mobile?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Touch controls appear automatically on phones and tablets. Works in Chrome, Safari, and Firefox on iOS and Android." } },
        { "@type": "Question", "name": "Can I save my progress?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Use F5 to save and F9 to load. You have 10 save slots (F7 to switch). Progress is stored in your browser." } },
        { "@type": "Question", "name": "What ROM formats are supported?", "acceptedAnswer": { "@type": "Answer", "text": "Supports .gba, .zip, .gb, and .gbc files. You can drag and drop ROMs or use the file picker." } }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Play GBA Games Online",
      "description": "Step-by-step guide to playing GBA games in your browser",
      "totalTime": "PT1M",
      "step": [
        { "@type": "HowToStep", "name": "Open the Emulator", "text": "Go to eggermath.com in your browser.", "url": SITE.url },
        { "@type": "HowToStep", "name": "Choose a Game", "text": "Click any game from the built-in library, or drag-and-drop your own .gba, .zip, .gb, or .gbc ROM file." },
        { "@type": "HowToStep", "name": "Play", "text": "Use keyboard controls (Arrow keys = D-Pad, K = A, J = B, Enter = Start) or touch controls on mobile." },
        { "@type": "HowToStep", "name": "Save Progress", "text": "Press F5 to save, F9 to load, F7 to switch between 10 save slots." }
      ]
    }
  ]
};
---

<EmulatorLayout jsonLd={jsonLd}>
  <NoscriptFallback />
  <main class="main">
    <UploadArea />
    <ContinueBar />
    <div class="pre-game-content" id="pre-game-content">
      <section class="browse-section">
        <div class="browse-header">
          <h1>GBA Emulator Online — Play 52 Games Free</h1>
          <span class="badge">Click to Play</span>
        </div>
        <p class="browse-sub">Play Pokemon, Zelda, Mario, Metroid and 48 more classic GBA games free in your browser. No download needed.</p>
        <div class="games-grid" id="games-grid">
          {games.map(game => (
            <GameCard
              title={game.title}
              genre={game.genre}
              slug={game.slug}
              img={game.img}
              mega={game.mega}
            />
          ))}
        </div>
      </section>
      <GuideSteps />

      <section class="content-section">
        <h2>What is a GBA Emulator?</h2>
        <p>A GBA emulator lets you play Game Boy Advance games directly in your web browser without downloading any software. Our emulator uses mGBA WebAssembly, the same engine used by professional emulation projects. It supports GBA, GBC, and GB games with save states, fast forward, and keyboard/touch controls. You can play Pokemon, Zelda, Mario, Metroid, and 48 more classic titles instantly.</p>

        <h2>How to Play GBA Games Online</h2>
        <ol>
          <li>Click any game from the library above, or drag-and-drop your own .gba ROM file</li>
          <li>The game loads instantly in your browser — no installation required</li>
          <li>Use keyboard controls: Arrow keys = D-Pad, K = A button, J = B button, Enter = Start</li>
          <li>Save your progress anytime with F5, load with F9, switch slots with F7</li>
        </ol>

        <h2>Why EggerMath?</h2>
        <ul>
          <li><strong>52 built-in games</strong> — Pokemon, Zelda, Mario, Metroid, and more</li>
          <li><strong>No download required</strong> — play directly in your browser</li>
          <li><strong>Save states</strong> — save and load your progress anytime</li>
          <li><strong>Fast forward</strong> — speed up boring parts</li>
          <li><strong>Mobile support</strong> — touch controls on phones and tablets</li>
          <li><strong>Works everywhere</strong> — Chrome, Safari, Firefox, Edge</li>
        </ul>

        <h2>Supported Games</h2>
        <p>We support over 52 classic GBA, GBC, and GB games including Pokemon Emerald, FireRed, LeafGreen, Ruby, Sapphire, The Legend of Zelda: A Link to the Past, Super Mario Advance, Metroid Fusion, and many more. All games run directly in your browser with no downloads required.</p>

        <h2>Keyboard Controls</h2>
        <p>Use your keyboard to play: Arrow keys for D-Pad movement, K for A button, J for B button, Q for L button, E for R button, Enter for Start, Right Shift for Select. Save state with F5, load state with F9, and switch between 10 save slots with F7.</p>

        <h2>Mobile Gaming</h2>
        <p>Play GBA games on your phone or tablet with touch controls. The emulator automatically detects mobile devices and shows on-screen controls. Works on iOS Safari, Chrome for Android, and Firefox mobile.</p>

        <h2>Frequently Asked Questions</h2>
        <div class="faq-item">
          <h3>Is it legal to play GBA games online?</h3>
          <p>Playing your own legally obtained ROM files is legal in most countries. EggerMath provides the emulator software only — you supply the ROM files.</p>
        </div>
        <div class="faq-item">
          <h3>Does it work on iPhone?</h3>
          <p>Yes. Our emulator works on iOS Safari with touch controls. No App Store download needed.</p>
        </div>
        <div class="faq-item">
          <h3>Can I play Pokemon GBA games?</h3>
          <p>Yes. We have Pokemon Emerald, FireRed, LeafGreen, Ruby, Sapphire, and more built-in. Just click to play.</p>
        </div>
        <div class="faq-item">
          <h3>How do I save my game?</h3>
          <p>Press F5 to save, F9 to load. You have 10 save slots — press F7 to switch between them. Your saves are stored in your browser.</p>
        </div>
        <div class="faq-item">
          <h3>What ROM formats are supported?</h3>
          <p>We support .gba, .zip, .gb, and .gbc files. You can drag and drop ROMs or use the file picker.</p>
        </div>
      </section>
    </div>
    <EmulatorContainer />
    <TouchControls />
    <ControlsHelp />
  </main>
</EmulatorLayout>

<script is:inline src="/ios-compat.js"></script>
<script is:inline type="module">
  import init from '/gba-emulator-web/mgba-v2.js';
  window.mGBA = init;
</script>
<script is:inline src="https://unpkg.com/megajs@1/dist/main.browser-umd.js"></script>
<script define:vars={{ gamesData: games }}>
  window.__GAMES_DATA__ = gamesData;
</script>
<script>
import '../scripts/emulator.js';
</script>
