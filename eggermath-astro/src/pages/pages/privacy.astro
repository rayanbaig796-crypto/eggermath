---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/games.js';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy — EggerMath",
  "url": `${SITE.url}/pages/privacy`,
  "publisher": { "@type": "Organization", "name": SITE.name, "url": SITE.url }
};
---

<BaseLayout
  title="Privacy Policy — EggerMath"
  description="EggerMath privacy policy. How we collect, use, and protect your data when you use our free online GBA emulator site."
  canonical={`${SITE.url}/pages/privacy`}
  jsonLd={jsonLd}
>
  <div class="page-wrap">
    <div class="page-header">
      <img src="/images/eggermath-logo.png" alt="EggerMath">
      <h1>Privacy Policy</h1>
    </div>
    <div class="page-body">
      <p class="updated">Last updated: August 18, 2026</p>
      <p>EggerMath ("we", "our", or "us") operates the eggermath.com website (the "Service"). This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website and use our browser-based Game Boy Advance emulator. Please read this policy carefully. By accessing or using the Service, you agree to the practices described herein.</p>
      <h2>1. Information We Collect</h2>
      <p><strong>Analytics Data.</strong> We use Google Analytics to collect anonymized usage information about how visitors interact with our website. This may include your IP address (which is anonymized), browser type and version, operating system, referring URLs, pages visited, time spent on each page, date and time of your visit, and general geographic region.</p>
      <p><strong>Local Storage (IndexedDB).</strong> The emulator stores data entirely within your browser using IndexedDB and localStorage. This includes your game save states, ROM files you upload, emulator configuration preferences, and your cookie consent selection. This data is stored locally on your device and is never transmitted to our servers or any third party.</p>
      <h2>2. How We Use Your Information</h2>
      <p>We use the information described above for the following purposes:</p>
      <ul>
        <li>To operate, maintain, and improve the Service and its features</li>
        <li>To analyze website traffic and usage trends to optimize performance</li>
        <li>To remember your emulator preferences and cookie consent selections</li>
        <li>To detect and prevent misuse, abuse, or security threats</li>
        <li>To comply with legal obligations</li>
      </ul>
      <h2>3. Third-Party Services</h2>
      <ul>
        <li><strong>Google Analytics</strong> — Provided by Google LLC. <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
        <li><strong>MEGA</strong> — Game files loaded from MEGA cloud storage. <a href="https://mega.io/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
      </ul>
      <h2>4. Children's Privacy</h2>
      <p>The Service is not directed to individuals under the age of 13 (or 16 in the EEA). We do not knowingly collect personal information from children.</p>
      <h2>5. Contact Us</h2>
      <p>If you have any questions about this Privacy Policy, please contact us:</p>
      <ul>
        <li><strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
