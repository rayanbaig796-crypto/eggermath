---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { games, SITE } from '../../data/games.js';
import { countries, getCountry } from '../../data/countries.js';
import { regionalKeywords } from '../../data/keywords.js';

export function getStaticPaths() {
  return Object.keys(countries).map(code => ({
    params: { country: code },
    props: { country: countries[code] },
  }));
}

const { country } = Astro.props;

// Get popular games for this country
const popularGameObjs = country.popularGames
  .map(slug => games.find(g => g.slug === slug))
  .filter(Boolean);

// Get 12 more games by genre variety
const moreGames = games
  .filter(g => !country.popularGames.includes(g.slug))
  .slice(0, 12);

// Regional keywords for this country
const regionKeywords = regionalKeywords[country.lang] || regionalKeywords['en'] || [];
const topKeywords = regionKeywords.slice(0, 5);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "EggerMath",
      "url": SITE.url,
      "logo": `${SITE.url}/favicon.svg`,
      "description": "Free browser-based GBA, GBC, and GB emulator. Play classic Game Boy games instantly online.",
      "sameAs": [
        "https://twitter.com/eggermath",
        "https://www.reddit.com/user/eggermath"
      ]
    },
    {
      "@type": "WebPage",
      "name": country.title,
      "description": country.description,
      "url": `${SITE.url}/${country.code}/`,
      "inLanguage": country.lang,
      "isPartOf": {
        "@type": "WebSite",
        "name": "EggerMath",
        "url": SITE.url
      }
    },
    {
      "@type": "CollectionPage",
      "name": country.title,
      "description": country.description,
      "url": `${SITE.url}/${country.code}/`,
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": popularGameObjs.length + moreGames.length,
        "itemListElement": [...popularGameObjs, ...moreGames].map((g, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "url": `${SITE.url}/${g.slug}/`,
          "name": `Play ${g.title} Online Free`
        }))
      },
      "provider": {
        "@type": "Organization",
        "name": "EggerMath",
        "url": SITE.url
      },
      "inLanguage": country.lang,
      "contentLocation": {
        "@type": "Country",
        "name": country.name,
        "identifier": country.code.toUpperCase()
      }
    }
  ]
};

// Generate hreflang links for all countries + x-default
const hreflangLinks = Object.entries(countries).map(([code, c]) => {
  return `<link rel="alternate" hreflang="${c.hreflang}" href="${SITE.url}/${code}/" />`;
}).join('\n  ');
const xDefault = `<link rel="alternate" hreflang="x-default" href="${SITE.url}/" />`;

// Build og:locale from country
const ogLocale = country.locale;
const ogAlternateLocales = Object.values(countries)
  .filter(c => c.locale !== ogLocale)
  .map(c => `<meta property="og:locale:alternate" content="${c.locale}" />`)
  .join('\n  ');
---
<BaseLayout
  title={country.title}
  description={country.description}
  canonical={`${SITE.url}/${country.code}/`}
  jsonLd={jsonLd}
  hreflangHtml={`${hreflangLinks}\n  ${xDefault}`}
>
  <meta property="og:locale" content={ogLocale} />
  <Fragment set:html={ogAlternateLocales} />

  <main style="max-width:1100px;margin:0 auto;padding:24px">
    <div style="text-align:center;margin-bottom:48px">
      <span style="font-size:48px">{country.flag}</span>
      <h1 style="font-size:2.5rem;margin:16px 0 8px;color:#f0ebe0">{country.title}</h1>
      <p style="color:#aaa;font-size:1.1rem;max-width:600px;margin:0 auto 24px">{country.description}</p>
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:16px">
        {topKeywords.map(kw => (
          <span style="background:#1a1a2e;border:1px solid #333;border-radius:20px;padding:4px 12px;font-size:12px;color:#888">{kw}</span>
        ))}
      </div>
    </div>

    <h2 style="font-size:1.5rem;margin:32px 0 16px;color:#c4a35a">Popular Games</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px;margin-bottom:48px">
      {popularGameObjs.map(game => (
        <a href={`/${game.slug}/`} style="text-decoration:none;background:#0d0d0d;border:1px solid #1a1a2e;border-radius:12px;overflow:hidden;transition:border-color 0.2s;display:block" onmouseover="this.style.borderColor='#c4a35a'" onmouseout="this.style.borderColor='#1a1a2e'">
          <img src={game.img} alt={game.title} style="width:100%;aspect-ratio:1;object-fit:cover" loading="lazy" />
          <div style="padding:12px">
            <div style="font-weight:600;color:#f0ebe0;font-size:14px">{game.title}</div>
            <div style="color:#888;font-size:12px;margin-top:4px">{game.genre}</div>
          </div>
        </a>
      ))}
    </div>

    <h2 style="font-size:1.5rem;margin:32px 0 16px;color:#c4a35a">More Games</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px;margin-bottom:48px">
      {moreGames.map(game => (
        <a href={`/${game.slug}/`} style="text-decoration:none;background:#0d0d0d;border:1px solid #1a1a2e;border-radius:12px;overflow:hidden;transition:border-color 0.2s;display:block" onmouseover="this.style.borderColor='#c4a35a'" onmouseout="this.style.borderColor='#1a1a2e'">
          <img src={game.img} alt={game.title} style="width:100%;aspect-ratio:1;object-fit:cover" loading="lazy" />
          <div style="padding:12px">
            <div style="font-weight:600;color:#f0ebe0;font-size:14px">{game.title}</div>
            <div style="color:#888;font-size:12px;margin-top:4px">{game.genre}</div>
          </div>
        </a>
      ))}
    </div>

    <section style="margin:48px 0;padding:32px;background:#1a1a2e;border-radius:12px">
      <h2 style="font-size:1.3rem;margin-bottom:16px;color:#f0ebe0">Why Play on EggerMath?</h2>
      <ul style="list-style:none;padding:0;display:grid;gap:12px">
        <li style="color:#ccc">✓ Free — no signup, no ads, no catch</li>
        <li style="color:#ccc">✓ No download — play directly in your browser</li>
        <li style="color:#ccc">✓ Save states — pick up where you left off</li>
        <li style="color:#ccc">✓ Mobile friendly — touch controls on phone/tablet</li>
        <li style="color:#ccc">✓ 52 classic GBA games — Pokemon, Zelda, Mario, and more</li>
      </ul>
    </section>

    <nav style="margin:32px 0;padding:24px;background:#111;border-radius:12px">
      <h3 style="font-size:1.1rem;margin-bottom:16px;color:#f0ebe0">Browse by Language</h3>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        {Object.entries(countries).map(([code, c]) => (
          <a href={`/${code}/`} style={`color:${code === country.code ? '#c4a35a' : '#888'};text-decoration:none;padding:4px 8px;border-radius:4px;font-size:14px;${code === country.code ? 'font-weight:700' : ''}`}>
            {c.flag} {c.name}
          </a>
        ))}
      </div>
    </nav>
  </main>
</BaseLayout>
