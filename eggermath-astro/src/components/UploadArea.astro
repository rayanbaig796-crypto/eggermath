---
---
<div id="upload-area">
  <div class="upload-content">
    <div class="icon">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="17 8 12 3 7 8"/>
        <line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
    </div>
    <div class="upload-title">Drop your GBA ROM here or browse</div>
    <div class="upload-hint">Drag any game file to run locally inside your browser with zero install</div>
    <div class="upload-tags">
      <span class="upload-tag">.gba</span>
      <span class="upload-tag">.gbc</span>
      <span class="upload-tag">.gb</span>
      <span class="upload-tag">.zip</span>
    </div>
  </div>
</div>
<input type="file" id="file-input" accept=".gba,.zip,.gb,.gbc" style="display:none">

