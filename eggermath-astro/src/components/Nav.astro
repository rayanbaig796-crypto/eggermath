<nav class="site-nav">
  <a href="/" class="site-brand">
    <div class="brand-icon-wrap">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c4a35a" stroke-width="2" stroke-linecap="round">
        <rect x="2" y="8" width="20" height="9" rx="4.5"/>
        <line x1="6.5" y1="10.5" x2="6.5" y2="14.5"/><line x1="4.5" y1="12.5" x2="8.5" y2="12.5"/>
        <circle cx="16" cy="11.5" r="1.2" fill="#c4a35a" stroke="none"/><circle cx="18.5" cy="13.5" r="1.2" fill="#c4a35a" stroke="none"/>
      </svg>
    </div>
    <span class="brand-name" data-i18n="brand">EggerMath</span>
  </a>
  <div class="nav-links">
    <a href="/" class="nav-link" data-i18n="allGames">All Games</a>
  </div>
</nav>
<script is:inline>
(function(){
  var dict={
    en:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"Emulator",allGames:"All Games"},
    es:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"Emulador",allGames:"Todos los Juegos"},
    hi:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"एम्युलेटर",allGames:"सभी गेम्स"},
    pt:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"Emulador",allGames:"Todos os Jogos"},
    fr:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"Émulateur",allGames:"Tous les Jeux"},
    de:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"Emulator",allGames:"Alle Spiele"},
    ja:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"エミュレータ",allGames:"すべてのゲーム"},
    zh:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"模拟器",allGames:"所有游戏"},
    ru:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"Эмулятор",allGames:"Все игры"},
    ar:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"المحاكي",allGames:"كل الألعاب"},
    it:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"Emulatore",allGames:"Tutti i Giochi"},
    id:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"Emulator",allGames:"Semua Game"},
    ko:{brand:"EggerMath",badge:"WebAssembly mGBA",emulator:"에뮬레이터",allGames:"모든 게임"}
  };
  function apply(){
    var lang=(navigator.language||"en").split("-")[0].toLowerCase();
    var t=dict[lang]||dict.en;
    document.querySelectorAll("[data-i18n]").forEach(function(el){
      var key=el.getAttribute("data-i18n");
      if(t[key]) el.textContent=t[key];
    });
    if(lang==="ar"){
      document.documentElement.dir="rtl";
      document.documentElement.lang="ar";
    } else {
      document.documentElement.dir="ltr";
      document.documentElement.lang=dict[lang]?lang:"en";
    }
  }
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",apply);
  else apply();
})();
</script>

