---
---
<style>
  body[data-system="GB"] .tc-shoulder-zone,
  body[data-system="GBC"] .tc-shoulder-zone { display: none !important; }
</style>
<div class="touch-controls" id="touch-controls">
  <div class="tc-shoulder-zone">
    <button class="tc-btn tc-shoulder-btn" data-btn="L">L</button>
    <button class="tc-btn tc-shoulder-btn" data-btn="R">R</button>
  </div>
  <div class="tc-dpad" id="tc-dpad">
    <div class="tc-dpad-bar tc-dpad-h">
      <div class="tc-dpad-arrow tc-dpad-arrow-l"></div>
      <div class="tc-dpad-arrow tc-dpad-arrow-r"></div>
    </div>
    <div class="tc-dpad-bar tc-dpad-v">
      <div class="tc-dpad-arrow tc-dpad-arrow-u"></div>
      <div class="tc-dpad-arrow tc-dpad-arrow-d"></div>
    </div>
  </div>
  <div class="tc-center-zone">
    <button class="tc-btn tc-center-btn" data-btn="Select">SELECT</button>
    <button class="tc-btn tc-center-btn" data-btn="Start">START</button>
  </div>
  <div class="tc-ab-zone">
    <button class="tc-btn tc-ab-btn tc-a-btn" data-btn="A">A</button>
    <button class="tc-btn tc-ab-btn tc-b-btn" data-btn="B">B</button>
  </div>
</div>
