---
---
<section class="guide-section">
  <h2>How to Play</h2>
  <p class="guide-sub">Get your favorite GBA games running in 3 easy steps</p>
  <div class="guide-steps">
    <div class="guide-step">
      <div class="step-num">1</div>
      <div class="step-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="11" x2="10" y2="11"/><line x1="8" y1="9" x2="8" y2="13"/>
          <line x1="15" y1="12" x2="15.01" y2="12"/><line x1="18" y1="10" x2="18.01" y2="10"/>
          <path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z"/>
        </svg>
      </div>
      <div class="step-title">Pick a Game</div>
      <div class="step-desc">
        Browse our library of 25+ popular GBA and GBC games above. Click on any game to start playing instantly.
      </div>
    </div>
    <div class="guide-step">
      <div class="step-num">2</div>
      <div class="step-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <div class="step-title">Wait for Loading</div>
      <div class="step-desc">
        The game loads directly in your browser from our secure library. Usually takes 5-15 seconds depending on your connection.
      </div>
    </div>
    <div class="guide-step">
      <div class="step-num">3</div>
      <div class="step-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="11" x2="10" y2="11"/><line x1="8" y1="9" x2="8" y2="13"/>
          <line x1="15" y1="12" x2="15.01" y2="12"/><line x1="18" y1="10" x2="18.01" y2="10"/>
          <path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z"/>
        </svg>
      </div>
      <div class="step-title">Start Playing</div>
      <div class="step-desc">
        Use your keyboard or touch controls to play. Save states, fast forward, and fullscreen are built in. Your progress is saved automatically.
      </div>
    </div>
  </div>
  <div class="guide-note">
    <strong>Tip:</strong> You can also drag & drop your own .gba, .zip, .gb, or .gbc files into the upload area. Your saves are stored locally in your browser — no account needed. Works best on Chrome and Edge.
  </div>
</section>
