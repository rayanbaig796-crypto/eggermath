---
import { SITE } from '../data/games.js';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  jsonLd?: object;
  noIndex?: boolean;
  hreflangHtml?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  canonical = SITE.url,
  jsonLd,
  noIndex = false,
  hreflangHtml,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-44ZYW1XML3');
  </script>
  <!-- Facebook Pixel -->
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', 'YOUR_PIXEL_ID');
    fbq('track', 'PageView');
  </script>
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#1a1a1a">
  <meta name="keywords" content="gba emulator, play gba online, gba games, gameboy advance emulator, pokemon gba, free gba emulator, browser emulator, retro gaming" />
  {hreflangHtml ? (
    <Fragment set:html={hreflangHtml} />
  ) : (
    <>
      <link rel="alternate" hreflang="en" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="pt-BR" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="es" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="ja" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="de" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="fr" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="ru" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="ko" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="it" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="id" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="ar" href={`https://www.eggermath.com${Astro.url.pathname}`} />
      <link rel="alternate" hreflang="x-default" href={`https://www.eggermath.com${Astro.url.pathname}`} />
    </>
  )}
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="pt_BR" />
  <meta property="og:locale:alternate" content="es_ES" />
  <meta property="og:locale:alternate" content="ja_JP" />
  <meta property="og:locale:alternate" content="de_DE" />
  <meta property="og:locale:alternate" content="fr_FR" />
  <meta property="og:locale:alternate" content="ru_RU" />
  <meta property="og:locale:alternate" content="ko_KR" />
  <meta property="og:locale:alternate" content="it_IT" />
  <meta property="og:locale:alternate" content="id_ID" />
  <meta property="og:locale:alternate" content="ar_SA" />
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:site" content="@eggermath">
  <meta name="twitter:creator" content="@eggermath">
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  )}
</head>
<body>
  <Nav />
  <div id="adsterra-banner" style="display:flex;justify-content:center;padding:0.5rem 0;background:#0d0d0d;">
    <script> atOptions = { 'key' : 'bfb74048c1b11dcc3bad492ec9dedcd7', 'format' : 'iframe', 'height' : 90, 'width' : 728, 'params' : {} }; </script>
    <script src="https://www.highrevenueformat.com/bfb74048c1b11dcc3bad492ec9dedcd7/invoke.js"></script>
  </div>
  <slot />
  <Footer />
  <!-- Adsterra Social Bar -->
  <script src="https://pl31186747.profitableratecpmnetwork.com/bc/eb/e3/bcebe3b9d2b0348dd139537d039d8b18.js"></script>
  <script is:inline>
    (function() {
      var style = document.createElement('style');
      style.textContent = 'body > div[id]:not([id="adsterra-banner"]):not([id="nav-wrap"]) { position:fixed!important; bottom:20px!important; right:20px!important; top:auto!important; left:auto!important; }';
      document.head.appendChild(style);

      function reposition() {
        var divs = document.body.children;
        for (var i = 0; i < divs.length; i++) {
          var el = divs[i];
          if (el.tagName === 'DIV' && el.id && el.id !== 'adsterra-banner' && el.id !== 'nav-wrap') {
            var s = el.getAttribute('style') || '';
            if (s.indexOf('position') !== -1) {
              el.style.setProperty('position', 'fixed', 'important');
              el.style.setProperty('bottom', '20px', 'important');
              el.style.setProperty('right', '20px', 'important');
              el.style.setProperty('top', 'auto', 'important');
              el.style.setProperty('left', 'auto', 'important');
              el.style.setProperty('z-index', '2147483647', 'important');
            }
          }
        }
      }

      var attempts = [2000, 4000, 7000, 10000, 15000, 20000];
      attempts.forEach(function(ms) { setTimeout(reposition, ms); });

      var obs = new MutationObserver(function() { reposition(); });
      obs.observe(document.body, { childList: true, subtree: true, attributes: true });
      setTimeout(function() { obs.disconnect(); }, 25000);
    })();
  </script>
</body>
</html>
