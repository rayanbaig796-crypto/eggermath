---
import { SITE } from '../data/games.js';
import { countries } from '../data/countries.js';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  jsonLd?: object;
  noIndex?: boolean;
  hreflangHtml?: string;
  ogLocale?: string;
  ogAlternateLocales?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  canonical = SITE.url,
  jsonLd,
  noIndex = false,
  hreflangHtml,
  ogLocale = 'en_US',
  ogAlternateLocales = '',
} = Astro.props;

// Detect current country from URL
const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const currentCountryCode = (pathParts.length > 0 && countries[pathParts[0]]) ? pathParts[0] : null;

// Build country hreflang links
const countryHreflangLinks = Object.entries(countries).map(([code, c]) => {
  return `<link rel="alternate" hreflang="${c.hreflang}" href="${SITE.url}/${code}/" />`;
}).join('\n    ');

// Build alternate OG locales from countries
const altLocales = ogAlternateLocales || Object.values(countries)
  .filter(c => c.locale !== ogLocale)
  .map(c => `<meta property="og:locale:alternate" content="${c.locale}" />`)
  .join('\n    ');
---
<!DOCTYPE html>
<html lang={currentCountryCode ? countries[currentCountryCode]?.lang || 'en' : 'en'} dir={(currentCountryCode && countries[currentCountryCode]?.lang === 'ar') ? 'rtl' : 'ltr'}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-44ZYW1XML3');
  </script>
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#1a1a1a">
  <meta name="keywords" content="gba emulator, play gba online, gba games, gameboy advance emulator, pokemon gba, free gba emulator" />
  <script defer src="/geo-detect.js"></script>
  {hreflangHtml ? (
    <Fragment set:html={hreflangHtml} />
  ) : (
    <>
      <link rel="alternate" hreflang="x-default" href={`${SITE.url}${Astro.url.pathname}`} />
      {countryHreflangLinks && <Fragment set:html={countryHreflangLinks} />}
    </>
  )}
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content={ogLocale} />
  {altLocales && <Fragment set:html={altLocales} />}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  )}
</head>
<body>
  <Nav />
  <slot />
  <Footer />
</body>
</html>
